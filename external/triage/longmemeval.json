{
  "benchmark": "LongMemEval",
  "source": "huggingface.co/datasets/xiaowu0162/longmemeval-cleaned \u2014 longmemeval_oracle.json (500 questions)",
  "triaged": "2026-09-13",
  "sampling": "purposeful, deterministic: first N question_ids in sorted order per stratum \u2014 12 knowledge-update, 12 temporal-reasoning, 6 single-session-preference, 6 abstention (ids ending _abs); no example was excluded or replaced after reading",
  "decision_rules_frozen_before_reading": {
    "finding_1_testable_if": "temporal_update_count >= 10",
    "finding_2_testable_if": "provenance_sensitive_count >= 5",
    "finding_3_testable_if": "type_dependent_count >= 5",
    "note": "knowledge-update is not automatically provenance-sensitive: only cases where the correct answer depends on WHO said it count"
  },
  "counts": {
    "classification": {
      "temporal_update": 7,
      "historical_state": 5,
      "other": 12,
      "static_recall": 12
    },
    "temporal_update_count": 10,
    "of_which_historical_as_of_needed": 5,
    "provenance_sensitive_count": 0,
    "type_dependent_count": 0,
    "static_controls": 12
  },
  "verdict": {
    "finding_1_bitemporal_sufficient": "TESTABLE, at the threshold \u2014 10/12 knowledge-update examples change a slot's value (the other two order dated events); 5 of the 10 require the earlier state (paired initial/current questions on one history), which is exactly where replace-in-place and SCD/keep_both diverge. 10 is the screening minimum, from a 12-example stratum of a 78-question category; the full category is expected to clear it comfortably and must be inspected before selection is frozen.",
    "finding_2_confidence_vs_authority": "NOT TESTABLE on this sample \u2014 0/36 provenance-sensitive; every write is the user's own statement; the two self-corrections (0f05491a) are same-speaker recency, not source authority",
    "finding_3_type_dependent_resolution": "NOT TESTABLE on this sample \u2014 types are implicit (facts, counts, events, preferences) but no example has structurally similar updates that resolve differently by type; preferences are single-session rubrics with no update",
    "temporal_reasoning_category": "NOT the same thing as temporal state: 12/12 sampled are date arithmetic or event lookup over dated events, no slot changes value. It does not feed Finding 1. Only knowledge-update does."
  },
  "adapter_implications": {
    "track": "E-B (extraction-mediated) \u2014 writes are numeric or nominal values embedded in free-text user turns ('I've added 25 new postcards'); the oracle has_answer flags identify WHICH turns carry the writes (so oracle-candidate evaluation is possible without retrieval), but the VALUE and the slot still need extraction. Deterministic normalisation is 'partial' on every state example.",
    "as_of": "question_date and per-session dates exist, so historical questions can be posed as as_of queries against session time",
    "gold": "knowledge-update gold is a short factual answer \u2014 usable as a state answer directly; preference gold is a free-text rubric \u2014 not usable for state-level evaluation",
    "negative_controls": "abstention questions are natural controls: the correct state is 'none'; six sampled, several paired with a positive question on the same history"
  },
